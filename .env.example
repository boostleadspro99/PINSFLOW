# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database
DATABASE_URL=""

# Authentication (NextAuth.js + Google OAuth)
# Generate NEXTAUTH_SECRET: openssl rand -base64 32
# Get GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET from Google Cloud Console
NEXTAUTH_SECRET=""
NEXTAUTH_URL=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Pinterest OAuth integration
# Create app at https://developers.pinterest.com/apps/
# Add your PINTEREST_REDIRECT_URI to the app's Redirect URIs
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
PINTEREST_REDIRECT_URI=""
# Generate PINTEREST_TOKEN_ENCRYPTION_KEY: openssl rand -hex 32
PINTEREST_TOKEN_ENCRYPTION_KEY=""
PINTEREST_API_BASE_URL="https://api.pinterest.com/v5"

# Publish Queue processing
# Generate PUBLISH_QUEUE_SECRET: openssl rand -base64 32
PUBLISH_QUEUE_SECRET=""
PUBLISH_QUEUE_BATCH_SIZE=1
PUBLISH_QUEUE_MAX_BATCH_SIZE=5
PUBLISH_QUEUE_LOCK_TIMEOUT_MINUTES=5

# Redis (optional, for advanced scheduling)
REDIS_URL=""

# Cloudflare Workers AI (low-cost text + image generation)
# Get CLOUDFLARE_ACCOUNT_ID from Cloudflare dashboard
# Create CLOUDFLARE_API_TOKEN with Workers AI permissions
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_AI_BASE_URL="https://api.cloudflare.com/client/v4"
CLOUDFLARE_AI_TEXT_MODEL="@cf/qwen/qwen3-30b-a3b-fp8"
CLOUDFLARE_AI_IMAGE_MODEL="@cf/black-forest-labs/flux-1-schnell"

# Cloudflare R2 (public image storage for Pinterest publishing)
# Required for Cloudflare-generated images to be Pinterest-publishable
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET=""
CLOUDFLARE_R2_PUBLIC_BASE_URL=""